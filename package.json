{
  "name": "@supersuit/capture-connector",
  "version": "0.1.0",
  "description": "The contract a capture connector honors (stage never file, dedupe by recording id, checkpoint only after staging, end with one CONNECTOR status line), as a validator, a CLI and TypeScript types, so a connector written anywhere can check itself.",
  "type": "module",
  "bin": {
    "capture-connector": "bin/capture-connector.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupersuitUp/capture-connector.git"
  },
  "dependencies": {},
  "types": "./src/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "capture",
    "connector",
    "contract",
    "validator",
    "freedom",
    "transcripts"
  ]
}
